# Firebase web app config (Project settings > General > Your apps).
# When any of these is missing the app still renders and the sign-in dialog
# says "Sign-in is not configured in this environment".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev-only fake sign-in for smoke tests. With `npm run dev` and this set, the
# app treats that uid as the signed-in user (no popup, no Firebase call) and
# sends `fake:<uid>:<uid>@example.test` as the bearer token, which only the
# backend's test wrapper accepts. It is ignored in production builds
# (import.meta.env.DEV is false there).
# VITE_AUTH_FAKE_UID=smoke-user
