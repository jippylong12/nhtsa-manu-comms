# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=nhtsa_comms

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# NHTSA API Base
NHTSA_API_BASE_URL=https://api.nhtsa.gov

# Postgres (Railway + pgvector). Never commit the real value.
DATABASE_URL=

# Anthropic API key (extraction bake-off). ANTHROPIC_API_KEY is accepted too.
CLAUDE_API_KEY=

# Where the test suite points instead of DATABASE_URL. Leave unset and the
# suite runs against DATABASE_URL, which is unreliable past ~200 tests —
# Railway's TCP proxy throttles the connection churn. Build the local replica
# with `bash tools/setup_test_db.sh`; see docs/database.md.
TEST_DATABASE_URL=postgresql://YOUR_USER@localhost:5433/nhtsa_comms_test
